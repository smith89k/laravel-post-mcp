{
    "name": "smith89k/laravel-post-mcp",
    "description": "Let Claude manage the blog posts of any Laravel site through MCP, using the site's existing Post model.",
    "keywords": ["laravel", "mcp", "claude", "blog", "posts", "ai", "model-context-protocol"],
    "homepage": "https://github.com/smith89k/laravel-post-mcp",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "smith89k",
            "homepage": "https://smith89k.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.41.1|^13.0",
        "illuminate/database": "^12.41.1|^13.0",
        "illuminate/support": "^12.41.1|^13.0",
        "laravel/mcp": "^1.3",
        "laravel/prompts": "^0.3",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/passport": "^13.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.8|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "laravel/passport": "Required for OAuth mode (claude.ai and Claude Desktop connectors).",
        "laravel/sanctum": "Can be used for token mode instead of Passport personal access tokens.",
        "spatie/laravel-medialibrary": "Required for the medialibrary media driver."
    },
    "autoload": {
        "psr-4": {
            "Smith89k\\PostMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Smith89k\\PostMcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Smith89k\\PostMcp\\PostMcpServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
